rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validRoot() {
      return request.resource.data.schema_version == 5
        && request.resource.data.save_revision is int
        && request.resource.data.digest is string
        && request.resource.data.digest.size() == 64
        && request.resource.data.coins is int
        && request.resource.data.coins >= 0 && request.resource.data.coins <= 2000000000
        && request.resource.data.updated_at == request.time;
    }
    // Offline backups confer no paid entitlement or competitive authority.
    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validRoot() && request.resource.data.save_revision == 1;
      allow update: if owner(uid) && validRoot()
        && request.resource.data.save_revision == resource.data.save_revision + 1;
      match /{section}/{id} {
        allow read: if owner(uid);
        // Every child write belongs to a root revision transaction.
        allow create, update: if owner(uid)
          && section in ['cars','inventory','progression','meta','transactions']
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.updated_at == request.time;
      }
    }
    // No delete, cross-user access, paid entitlement or competitive record writes.
  }
}
